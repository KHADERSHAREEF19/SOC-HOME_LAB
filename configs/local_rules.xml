<!--
  ============================================================================
  SOC-HOME-LAB — Custom Wazuh Detection Rules
  ============================================================================
  Manager location:  /var/ossec/etc/rules/local_rules.xml
  Apply with:        sudo systemctl restart wazuh-manager

  Philosophy (what a recruiter should notice):
    * Base rules (level 0-3) classify the atomic event.
    * Correlation rules (frequency / time window) elevate real attack patterns.
    * Every rule carries MITRE ATT&CK IDs and meaningful groups.
    * Thresholds are tuned to reduce false positives (documented per rule).

  NOTE: Field names below follow Wazuh 4.x Windows decoders. Always verify
  against one of your own events (dashboard -> event JSON tab) since names can
  shift slightly between versions.
  ============================================================================
-->

<group name="windows,sysmon,attack,">

  <!-- ====================================================================
       100100 — BASE: Windows failed logon (Event ID 4625)
       ==================================================================== -->
  <rule id="100100" level="3">
    <field name="win.system.eventID">^4625$</field>
    <description>Windows failed logon: user $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress) (logon type $(win.eventdata.logonType))</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,win_authentication_failed,</group>
  </rule>

  <!-- ====================================================================
       100101 — CORRELATION: Brute force
       >= 8 failed logons from the SAME source IP within 120 seconds
       Threshold rationale: 8/120s catches Hydra default pacing while
       ignoring ordinary typos (1-3 failures) by real users.
       ==================================================================== -->
  <rule id="100101" level="12">
    <if_matched_sid>100100</if_matched_sid>
    <frequency>8</frequency>
    <timeframe>120</timeframe>
    <same_field name="win.eventdata.ipAddress" />
    <description>Possible brute-force attack: $(frequency) failed logons from $(win.eventdata.ipAddress) against $(win.system.computer) in $(timeframe) seconds</description>
    <mitre><id>T1110.001</id><id>T1110.003</id></mitre>
    <group>authentication_failures,brute_force,pci_dss_10.2.4,pci_dss_11.4,</group>
  </rule>

  <!-- ====================================================================
       100102 — CORRELATION: Successful logon AFTER a brute-force burst
       A successful 4624 shortly after rule 100101 fired means the attacker
       "got in". Escalate to critical — this is the incident trigger.
       ==================================================================== -->
  <rule id="100102" level="14">
    <if_matched_sid>100101</if_matched_sid>
    <frequency>1</frequency>
    <timeframe>600</timeframe>
    <field name="win.system.eventID">^4624$</field>
    <same_field name="win.eventdata.ipAddress" />
    <description>CRITICAL: successful logon from $(win.eventdata.ipAddress) immediately after brute-force activity on $(win.system.computer) — credential compromise suspected</description>
    <mitre><id>T1110.001</id><id>T1078</id></mitre>
    <group>authentication_success,brute_force,pci_dss_10.2.5,</group>
  </rule>

  <!-- ====================================================================
       100110 — Suspicious PowerShell execution (Sysmon EID 1)
       Flags: encoded command, base64, download cradles, hidden window
       ==================================================================== -->
  <rule id="100110" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\\\powershell(\.exe)?$|\\\\pwsh(\.exe)?$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-e(nc|ncodedcommand)?\s|frombase64string|downloadstring|invoke-expression|\biex\b|start-bitstransfer|-w(indowstyle)?\s+hidden|-nop\b</field>
    <description>Suspicious PowerShell execution on $(win.system.computer): $(win.eventdata.commandLine)</description>
    <mitre><id>T1059.001</id><id>T1105</id><id>T1140</id></mitre>
    <group>windows_powershell,suspicious_commands,</group>
  </rule>

  <!-- ====================================================================
       100120 — Windows audit log cleared (wevtutil)
       Companion to the built-in Windows 1102 event rule.
       ==================================================================== -->
  <rule id="100120" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)wevtutil(\.exe)?$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\scl(\s|$)|clear-log|sl\s+\w+\s+/e:false</field>
    <description>Defense evasion: Windows event log cleared/disabled with wevtutil on $(win.system.computer): $(win.eventdata.commandLine)</description>
    <mitre><id>T1070.001</id><id>T1562.001</id></mitre>
    <group>defense_evasion,windows_defense_evasion,</group>
  </rule>

  <!-- ====================================================================
       100130 — Scheduled task creation (schtasks /create)
       Companion to Windows Security 4698 (task created).
       ==================================================================== -->
  <rule id="100130" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)schtasks(\.exe)?$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Scheduled task creation via schtasks on $(win.system.computer): $(win.eventdata.commandLine)</description>
    <mitre><id>T1053.005</id></mitre>
    <group>windows_persistence,persistence,</group>
  </rule>

  <!-- ====================================================================
       100135 — Registry Run-key persistence (Sysmon EID 13)
       Autorun location = classic malware persistence.
       ==================================================================== -->
  <rule id="100135" level="10">
    <if_sid>57003</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\\\CurrentVersion\\\\(Run|RunOnce|Policies\\\\Explorer\\\\Run)</field>
    <description>Registry autorun persistence on $(win.system.computer): $(win.eventdata.targetObject) set to $(win.eventdata.details)</description>
    <mitre><id>T1547.001</id></mitre>
    <group>windows_persistence,persistence,sysmon,</group>
  </rule>

  <!-- ====================================================================
       100140 — CORRELATION: Host/Account discovery command cluster
       >= 3 distinct recon commands from the same host in 300 seconds.
       Individual whoami is normal; whoami + systeminfo + net user is not.
       ==================================================================== -->
  <rule id="100140" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\bwhoami\b|\bsysteminfo\b|\bipconfig\s+/all\b|\bnet\s+(user|group|localgroup|accounts)\b|\btasklist\b|\bnetstat\s+-an\b|\bnltest\b|\bdsquery\b</field>
    <frequency>3</frequency>
    <timeframe>300</timeframe>
    <same_field name="win.system.computer" />
    <description>Host/account discovery command cluster on $(win.system.computer) from $(win.eventdata.parentImage) — possible post-exploitation recon</description>
    <mitre><id>T1082</id><id>T1087</id><id>T1033</id><id>T1016</id></mitre>
    <group>windows_discovery,discovery,</group>
  </rule>

  <!-- ====================================================================
       100145 — EICAR / known test-malware artifact written to disk
       Caught via Sysmon EID 11 (file create) or Defender 1116/1117.
       ==================================================================== -->
  <rule id="100145" level="10">
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)eicar|\\\\eicar\.com$</field>
    <description>Known test-malware artifact (EICAR) written on $(win.system.computer): $(win.eventdata.targetFilename)</description>
    <mitre><id>T1204.002</id><id>T1105</id></mitre>
    <group>malware,windows_malware,</group>
  </rule>

</group>
